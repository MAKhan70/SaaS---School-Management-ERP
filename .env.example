# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only canonical origin used for CSRF/Host validation.
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Database — local Docker credentials only; use managed secrets outside development.
# Application traffic uses the restricted RLS role. Prisma migrations use the owner URL.
DATABASE_URL=postgresql://nasaq_app:nasaq_app_local_only@localhost:5432/nasaq?schema=public
DIRECT_DATABASE_URL=postgresql://nasaq_owner:nasaq_owner_local_only@localhost:5432/nasaq?schema=public
# Development migrations only. Never point this at a database containing application data.
SHADOW_DATABASE_URL=postgresql://nasaq_owner:nasaq_owner_local_only@localhost:5432/nasaq_shadow?schema=public

# Authentication — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
# AES-256-GCM key for restricted student health/demographic records: openssl rand -base64 32
STUDENT_DATA_ENCRYPTION_KEY=
# Optional fictional local-demo credential. Do not set this in production.
DEMO_USER_PASSWORD=

# Reserved integration ports
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_BUCKET=nasaq-local
ALLOW_PUBLIC_ONBOARDING=true

# Optional Supabase deployment/invitation adapter. See .env.supabase.example.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVITE_FROM_EMAIL=
RESEND_API_KEY=
