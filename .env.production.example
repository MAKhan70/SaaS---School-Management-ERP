NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://school.example.invalid
APP_ORIGIN=https://school.example.invalid
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
DATABASE_URL=postgresql://app-user:managed-secret@production-db.example.invalid:5432/nasaq?sslmode=require&schema=public
DIRECT_DATABASE_URL=postgresql://migration-user:managed-secret@production-db.example.invalid:5432/nasaq?sslmode=require&schema=public
AUTH_SECRET=inject-at-runtime-from-secret-manager-minimum-32-characters
STUDENT_DATA_ENCRYPTION_KEY=inject-at-runtime-from-secret-manager
OBJECT_STORAGE_BUCKET=nasaq-production-private
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=inject-at-runtime-from-secret-manager
SUPABASE_INVITE_FROM_EMAIL=NASAQ Academic Systems <no-reply@your-verified-domain.example>
RESEND_API_KEY=inject-at-edge-function-runtime
ALLOW_PUBLIC_ONBOARDING=false
PLATFORM_ADMIN_EMAIL=inject-at-seed-time-only
PLATFORM_ADMIN_NAME=NASAQ Platform Administrator
PLATFORM_ADMIN_PASSWORD=inject-at-seed-time-only
