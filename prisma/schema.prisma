  updater          User                     @relation("OperationalRecordUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  events           OperationalRecordEvent[]

  @@unique([trustId, schoolId, id])
  @@unique([trustId, schoolId, module, referenceNumber])
