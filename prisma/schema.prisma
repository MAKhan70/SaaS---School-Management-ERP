model Platform {
  id            String               @id @default(cuid())
  key           String               @unique
  name          String
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  trusts        Trust[]
  permissions   Permission[]
  roles         Role[]
  featureGrants TenantFeatureGrant[]

  @@map("platforms")
}

model Trust {
  id                      String                          @id @default(cuid())
  platformId              String                          @map("platform_id")
  slug                    String                          @unique
  name                    String
  defaultLocale           String                          @default("en-IN") @map("default_locale")
  defaultTimezone         String                          @default("Asia/Kolkata") @map("default_timezone")
  defaultCurrency         String                          @default("INR") @map("default_currency")
  status                  RecordStatus                    @default(ACTIVE)
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  archivedAt              DateTime?                       @map("archived_at")
  platform                Platform                        @relation(fields: [platformId], references: [id], onDelete: Restrict)
  schools                 School[]
  academicYears           AcademicYear[]
  academicTerms           AcademicTerm[]
  workingDayRules         WorkingDayRule[]
  calendarDays            SchoolCalendarDay[]
  rooms                   Room[]
  periods                 Period[]
  gradingScales           GradingScale[]
  gradeBands              GradeBand[]
  houses                  House[]
  numberingRules          NumberingRule[]
  persons                 Person[]
  memberships             SchoolMembership[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  roleAssignments         UserRoleAssignment[]
  boardConfigurations     BoardConfiguration[]
  gradeClasses            GradeClass[]
  sections                Section[]
  streams                 Stream[]
  departments             Department[]
  subjects                Subject[]
  studentProfiles         StudentProfile[]
  staffProfiles           StaffProfile[]
  guardianRelations       GuardianRelationship[]
  studentEnrollments      StudentEnrollment[]
  staffAssignments        StaffAssignment[]
  sensitiveIdentifiers    SensitiveIdentifier[]
  auditEvents             AuditEvent[]
  onboarding              TenantOnboarding?
  staffInvitations        StaffInvitation[]
  userTrustAccess         UserTrustAccess[]
  studentAdmissions       StudentAdmission[]
  personContacts          PersonContact[]
  personAddresses         PersonAddress[]
  emergencyContacts       StudentEmergencyContact[]
  studentSensitive        StudentSensitiveRecord[]
  studentDocuments        StudentDocument[]
  studentNotes            StudentNote[]
  studentTags             StudentTag[]
  studentTagLinks         StudentTagAssignment[]
  studentHouseLinks       StudentHouseAssignment[]
  studentIdentityCards    StudentIdentityCard[]
  enrollmentEvents        StudentEnrollmentEvent[]
  admissionForms          AdmissionForm[]
  admissionApplications   AdmissionApplication[]
  admissionActivities     AdmissionActivity[]
  admissionFollowUps      AdmissionFollowUp[]
  admissionDocuments      AdmissionDocument[]
  admissionSchedules      AdmissionSchedule[]
  admissionSeatPlans      AdmissionSeatPlan[]
  admissionNotifications  AdmissionNotificationPreview[]
  attendanceStatuses      AttendanceStatusDefinition[]
  teachingAssignments     AttendanceTeachingAssignment[]
  attendanceSessions      StudentAttendanceSession[]
  studentAttendance       StudentAttendanceRecord[]
  attendanceChanges       StudentAttendanceChange[]
  attendanceReopenings    AttendanceReopenRequest[]
  studentLeaveRequests    StudentLeaveRequest[]
  staffShifts             StaffShift[]
  staffShiftAssignments   StaffShiftAssignment[]
  staffAttendance         StaffAttendanceRecord[]
  staffCorrections        StaffAttendanceCorrection[]
  staffLeaveRequests      StaffLeaveRequest[]
  attendanceDevices       AttendanceDevice[]
  attendanceDeviceEvents  AttendanceDeviceEvent[]
  attendanceNotifications AttendanceNotificationPreview[]
  examinationRuleSets     ExaminationRuleSet[]            @relation("ExaminationRuleSetTrust")
  examinations            Examination[]                   @relation("ExaminationTrust")
  operationalRecords      OperationalRecord[]
  operationalRecordEvents OperationalRecordEvent[]
  aiAssistanceRecords     AiAssistanceRecord[]
  aiAssistanceAuditEvents AiAssistanceAuditEvent[]
  supportIndicators       StudentSupportIndicator[]
  supportIndicatorEvents  StudentSupportIndicatorEvent[]
  featureGrants           TenantFeatureGrant[]
  supportAccessGrants     SupportAccessGrant[]

  @@unique([platformId, id])
  @@index([platformId, status])
  @@map("trusts")
}

