  updatedAt        DateTime                       @updatedAt @map("updated_at")
  trust            Trust                          @relation(fields: [trustId], references: [id], onDelete: Restrict)
  school           School                         @relation("SupportIndicatorSchool", fields: [trustId, schoolId], references: [trustId, id], onDelete: Restrict)
  campus           Campus                         @relation("SupportIndicatorCampus", fields: [trustId, schoolId, campusId], references: [trustId, schoolId, id], onDelete: Restrict)
  academicYear     AcademicYear                   @relation("SupportIndicatorAcademicYear", fields: [trustId, schoolId, academicYearId], references: [trustId, schoolId, id], onDelete: Restrict)
  studentProfile   StudentProfile                 @relation("SupportIndicatorStudent", fields: [trustId, studentProfileId], references: [trustId, id], onDelete: Restrict)
  reviewer         User?                          @relation("SupportIndicatorReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  events           StudentSupportIndicatorEvent[]

  @@unique([trustId, schoolId, academicYearId, studentProfileId, ruleKey, ruleVersion, observedOn])
  @@unique([trustId, schoolId, id])
  @@index([trustId, schoolId, campusId, academicYearId, status, observedOn])
  @@index([trustId, studentProfileId, status, observedOn])
  @@map("student_support_indicators")
}

model StudentSupportIndicatorEvent {
  id          String                  @id @default(cuid())
  trustId     String                  @map("trust_id")
  schoolId    String                  @map("school_id")
  indicatorId String                  @map("indicator_id")
  action      String
  fromStatus  SupportIndicatorStatus? @map("from_status")
  toStatus    SupportIndicatorStatus  @map("to_status")
  note        String
  factors     Json?
  actorUserId String                  @map("actor_user_id")
  occurredAt  DateTime                @default(now()) @map("occurred_at")
  indicator   StudentSupportIndicator @relation(fields: [trustId, schoolId, indicatorId], references: [trustId, schoolId, id], onDelete: Restrict)
  trust       Trust                   @relation(fields: [trustId], references: [id], onDelete: Restrict)
  school      School                  @relation("SupportIndicatorEventSchool", fields: [trustId, schoolId], references: [trustId, id], onDelete: Restrict)
  actor       User                    @relation("SupportIndicatorEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([trustId, schoolId, indicatorId, occurredAt])
  @@index([trustId, schoolId, action, occurredAt])
  @@map("student_support_indicator_events")
}
