model Campus {
  id                    String                         @id @default(cuid())
  trustId               String                         @map("trust_id")
  schoolId              String                         @map("school_id")
  code                  String
  name                  String
  timezone              String                         @default("Asia/Kolkata")
  status                RecordStatus                   @default(ACTIVE)
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  archivedAt            DateTime?                      @map("archived_at")
  school                School                         @relation(fields: [trustId, schoolId], references: [trustId, id], onDelete: Restrict)
  memberships           SchoolMembership[]
  rooms                 Room[]
  periods               Period[]
  calendarDays          SchoolCalendarDay[]
  sections              Section[]
  roleAssignments       UserRoleAssignment[]
  studentEnrollments    StudentEnrollment[]
  staffAssignments      StaffAssignment[]
  staffInvitations      StaffInvitation[]
  studentAdmissions     StudentAdmission[]
  emergencyContacts     StudentEmergencyContact[]
  studentDocuments      StudentDocument[]
  studentHouseLinks     StudentHouseAssignment[]
  identityCards         StudentIdentityCard[]
  admissionApplications AdmissionApplication[]
  teachingAssignments   AttendanceTeachingAssignment[]
  attendanceSessions    StudentAttendanceSession[]
  studentAttendance     StudentAttendanceRecord[]
  attendanceChanges     StudentAttendanceChange[]
  attendanceReopenings  AttendanceReopenRequest[]
  studentLeaveRequests  StudentLeaveRequest[]
  staffShifts           StaffShift[]
  staffShiftAssignments StaffShiftAssignment[]
  staffAttendance       StaffAttendanceRecord[]
  staffCorrections      StaffAttendanceCorrection[]
  staffLeaveRequests    StaffLeaveRequest[]
  attendanceDevices     AttendanceDevice[]
  deviceEvents          AttendanceDeviceEvent[]
  examinations          Examination[]                  @relation("ExaminationCampus")
  feePayments           FeePayment[]                   @relation("FeePaymentCampus")
  collectionClosures    DailyCollectionClosure[]       @relation("DailyCollectionClosureCampus")
  financialAuditEntries FinancialAuditEntry[]          @relation("FinancialAuditCampus")
  dashboardItems        DashboardFeedItem[]            @relation("DashboardFeedCampus")
  operationalRecords    OperationalRecord[]            @relation("OperationalRecordCampus")
  aiAssistanceRecords   AiAssistanceRecord[]           @relation("AiAssistanceCampus")
  supportIndicators     StudentSupportIndicator[]      @relation("SupportIndicatorCampus")

  @@unique([trustId, id])
  @@unique([trustId, schoolId, id])
  @@unique([trustId, schoolId, code])
  @@index([trustId, schoolId, status])
  @@map("campuses")
}

model AcademicYear {
  id                    String                         @id @default(cuid())
  trustId               String                         @map("trust_id")
  schoolId              String?                        @map("school_id")
  code                  String
  name                  String
  startsOn              DateTime                       @map("starts_on") @db.Date
  endsOn                DateTime                       @map("ends_on") @db.Date
  status                AcademicYearStatus             @default(PLANNED)
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  archivedAt            DateTime?                      @map("archived_at")
  copiedFromId          String?                        @map("copied_from_id")
  trust                 Trust                          @relation(fields: [trustId], references: [id], onDelete: Restrict)
  school                School?                        @relation(fields: [trustId, schoolId], references: [trustId, id], onDelete: Restrict)
  copiedFrom            AcademicYear?                  @relation("AcademicYearCopy", fields: [trustId, copiedFromId], references: [trustId, id], onDelete: Restrict)
  copiedYears           AcademicYear[]                 @relation("AcademicYearCopy")
  terms                 AcademicTerm[]
  workingDayRules       WorkingDayRule[]
  calendarDays          SchoolCalendarDay[]
  periods               Period[]
  gradingScales         GradingScale[]
  numberingRules        NumberingRule[]
  sections              Section[]
  studentEnrollments    StudentEnrollment[]
  studentAdmissions     StudentAdmission[]
  studentHouseLinks     StudentHouseAssignment[]
  admissionForms        AdmissionForm[]
  admissionApplications AdmissionApplication[]
  admissionSeatPlans    AdmissionSeatPlan[]
  attendanceStatuses    AttendanceStatusDefinition[]
  teachingAssignments   AttendanceTeachingAssignment[]
  attendanceSessions    StudentAttendanceSession[]
  studentAttendance     StudentAttendanceRecord[]
  attendanceChanges     StudentAttendanceChange[]
  attendanceReopenings  AttendanceReopenRequest[]
  studentLeaveRequests  StudentLeaveRequest[]
  staffShiftAssignments StaffShiftAssignment[]
  staffAttendance       StaffAttendanceRecord[]
  staffCorrections      StaffAttendanceCorrection[]
  staffLeaveRequests    StaffLeaveRequest[]
  deviceEvents          AttendanceDeviceEvent[]
  examinations          Examination[]                  @relation("ExaminationAcademicYear")
  reportCardTemplates   ReportCardTemplate[]           @relation("ReportCardTemplateAcademicYear")
  feeStructures         FeeStructure[]
  feePayments           FeePayment[]                   @relation("FeePaymentAcademicYear")
  feeReceiptSequences   FeeReceiptSequence[]           @relation("FeeReceiptSequenceAcademicYear")
  collectionClosures    DailyCollectionClosure[]       @relation("DailyCollectionClosureAcademicYear")
  financialAuditEntries FinancialAuditEntry[]          @relation("FinancialAuditAcademicYear")
  dashboardItems        DashboardFeedItem[]            @relation("DashboardFeedAcademicYear")
  operationalRecords    OperationalRecord[]            @relation("OperationalRecordAcademicYear")
  aiAssistanceRecords   AiAssistanceRecord[]           @relation("AiAssistanceAcademicYear")
  supportIndicators     StudentSupportIndicator[]      @relation("SupportIndicatorAcademicYear")

  @@unique([trustId, id])
  @@unique([trustId, schoolId, id])
  @@unique([trustId, code])
  @@index([trustId, schoolId, status, startsOn, endsOn])
  @@index([trustId, status, startsOn, endsOn])
  @@map("academic_years")
}

model AcademicTerm {
  id             String        @id @default(cuid())
  trustId        String        @map("trust_id")
  schoolId       String        @map("school_id")
  academicYearId String        @map("academic_year_id")
  code           String
  name           String
  sequence       Int
  startsOn       DateTime      @map("starts_on") @db.Date
  endsOn         DateTime      @map("ends_on") @db.Date
  status         RecordStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  archivedAt     DateTime?     @map("archived_at")
  trust          Trust         @relation(fields: [trustId], references: [id], onDelete: Restrict)
  school         School        @relation(fields: [trustId, schoolId], references: [trustId, id], onDelete: Restrict)
  academicYear   AcademicYear  @relation(fields: [trustId, academicYearId], references: [trustId, id], onDelete: Restrict)
  examinations   Examination[] @relation("ExaminationAcademicTerm")

  @@unique([trustId, schoolId, academicYearId, id])
  @@unique([trustId, schoolId, academicYearId, code])
  @@unique([trustId, schoolId, academicYearId, sequence])
  @@index([trustId, schoolId, academicYearId, status])
  @@map("academic_terms")
}

model BoardConfiguration {
  id                  String                   @id @default(cuid())
  trustId             String                   @map("trust_id")
  schoolId            String                   @map("school_id")
  boardType           BoardType                @map("board_type")
  stateCode           String?                  @map("state_code")
  name                String
  version             Int
  rules               Json
  effectiveFrom       DateTime                 @map("effective_from") @db.Date
  effectiveTo         DateTime?                @map("effective_to") @db.Date
  status              BoardConfigurationStatus @default(DRAFT)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  archivedAt          DateTime?                @map("archived_at")
  trust               Trust                    @relation(fields: [trustId], references: [id], onDelete: Restrict)
  school              School                   @relation(fields: [trustId, schoolId], references: [trustId, id], onDelete: Restrict)
  gradeClasses        GradeClass[]
  examinationRuleSets ExaminationRuleSet[]     @relation("ExaminationRuleSetBoard")
  reportCardTemplates ReportCardTemplate[]     @relation("ReportCardTemplateBoard")

  @@unique([trustId, schoolId, id])
  @@unique([trustId, schoolId, boardType, version])
  @@index([trustId, schoolId, status, effectiveFrom, effectiveTo])
  @@map("board_configurations")
}

model GradeClass {
  id                    String                 @id @default(cuid())
  trustId               String                 @map("trust_id")
  schoolId              String                 @map("school_id")
  boardConfigurationId  String                 @map("board_configuration_id")
  code                  String
  name                  String
  level                 Int
